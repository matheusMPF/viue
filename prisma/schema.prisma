generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_content {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_id          String                 @db.VarChar(100)
  external_source      String                 @db.VarChar(50)
  type                 content_type
  title                String                 @db.VarChar(255)
  original_title       String?                @db.VarChar(255)
  description          String?
  poster_url           String?                @db.VarChar(500)
  backdrop_url         String?                @db.VarChar(500)
  release_date         DateTime?              @db.Date
  external_rating      Decimal?               @db.Decimal(3, 1)
  external_votes       Int?
  status               content_status         @default(ACTIVE)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  tb_content_genre     tb_content_genre[]
  tb_content_streaming tb_content_streaming[]
  tb_movie             tb_movie?
  tb_room_content      tb_room_content[]
  tb_series            tb_series?
  tb_user_content      tb_user_content[]

  @@unique([external_id, external_source], map: "uk_tb_content_external")
  @@index([external_source], map: "idx_tb_content_external_source")
  @@index([title], map: "idx_tb_content_title")
  @@index([type], map: "idx_tb_content_type")
}

model tb_content_genre {
  content_id String     @db.Uuid
  genre_id   String     @db.Uuid
  tb_content tb_content @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_content_genre_content")
  tb_genre   tb_genre   @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_content_genre_genre")

  @@id([content_id, genre_id])
  @@index([genre_id], map: "idx_tb_content_genre_genre_id")
}

model tb_content_streaming {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_id           String               @db.Uuid
  streaming_service_id String               @db.Uuid
  url                  String?              @db.VarChar(500)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  tb_content           tb_content           @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_content_streaming_content")
  tb_streaming_service tb_streaming_service @relation(fields: [streaming_service_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_content_streaming_service")

  @@unique([content_id, streaming_service_id], map: "uk_tb_content_streaming")
  @@index([streaming_service_id], map: "idx_tb_content_streaming_service_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_episode {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season_id        String            @db.Uuid
  external_id      String?           @db.VarChar(100)
  episode_number   Int
  title            String            @db.VarChar(255)
  description      String?
  still_url        String?           @db.VarChar(500)
  release_date     DateTime?         @db.Date
  duration_minutes Int?
  external_rating  Decimal?          @db.Decimal(3, 1)
  external_votes   Int?
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  tb_season        tb_season         @relation(fields: [season_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_episode_season")
  tb_user_episode  tb_user_episode[]

  @@unique([season_id, episode_number], map: "uk_tb_episode_number")
  @@index([external_id], map: "idx_tb_episode_external_id")
  @@index([season_id], map: "idx_tb_episode_season_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_friendship {
  id                                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_id                                String            @db.Uuid
  addressee_id                                String            @db.Uuid
  status                                      friendship_status @default(PENDING)
  created_at                                  DateTime          @default(now()) @db.Timestamptz(6)
