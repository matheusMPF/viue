enum content_status {
  ACTIVE
  INACTIVE
}

enum content_type {
  MOVIE
  SERIES
}

enum friendship_status {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum library_status {
  WANT_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
  ON_HOLD
}

enum otp_purpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum room_invite_status {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum room_match_mode {
  ALL_PARTICIPANTS
  ANY_PAIR
}

enum room_status {
  ACTIVE
  CLOSED
}

enum user_role {
  USER
  ADMIN
}

enum user_status {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}
