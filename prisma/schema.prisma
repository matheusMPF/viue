  tb_content tb_content @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_room_content_content")
  tb_room    tb_room    @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_room_content_room")

  @@unique([room_id, content_id], map: "uk_tb_room_content")
  @@index([added_by], map: "idx_tb_room_content_added_by")
  @@index([content_id], map: "idx_tb_room_content_content")
  @@index([room_id], map: "idx_tb_room_content_room")
}

