  tb_user_tb_friendship_addressee_idTotb_user tb_user           @relation("tb_friendship_addressee_idTotb_user", fields: [addressee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_friendship_addressee")
  tb_user_tb_friendship_requester_idTotb_user tb_user           @relation("tb_friendship_requester_idTotb_user", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_friendship_requester")

  @@unique([requester_id, addressee_id], map: "uk_tb_friendship")
  @@index([addressee_id], map: "idx_tb_friendship_addressee")
  @@index([requester_id], map: "idx_tb_friendship_requester")
  @@index([status], map: "idx_tb_friendship_status")
}

model tb_genre {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique(map: "uk_tb_genre_name") @db.VarChar(100)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  tb_content_genre tb_content_genre[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_movie {
  content_id       String     @id @db.Uuid
  duration_minutes Int?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  tb_content       tb_content @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_movie_content")
