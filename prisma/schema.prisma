  @@index([expires_at], map: "idx_tb_otp_expires_at")
  @@index([user_id], map: "idx_tb_otp_user_id")
}

model tb_refresh_token {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
