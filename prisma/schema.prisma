model tb_room {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id            String                @db.Uuid
  name                String                @db.VarChar(150)
  description         String?
  status              room_status           @default(ACTIVE)
  match_mode          room_match_mode       @default(ALL_PARTICIPANTS)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  tb_user             tb_user               @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tb_room_owner")
  tb_room_content     tb_room_content[]
  tb_room_invite      tb_room_invite[]
  tb_room_participant tb_room_participant[]

  @@index([owner_id], map: "idx_tb_room_owner_id")
  @@index([status], map: "idx_tb_room_status")
}

model tb_room_content {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
