# Use apenas letras e numeros hexadecimais na senha para que a URL do PostgreSQL
# nao precise de codificacao adicional. Gere com: openssl rand -hex 24
POSTGRES_DB=viue
POSTGRES_USER=viue
POSTGRES_PASSWORD=substitua_por_um_segredo_forte

# Porta local da VPS. Nao fica exposta publicamente; o Nginx encaminha para ela.
APP_PORT=3001

# Gere com: openssl rand -hex 32
JWT_SECRET=substitua_por_um_segredo_com_pelo_menos_32_caracteres

BREVO_API_KEY=substitua_pela_chave_da_brevo
BREVO_SENDER_EMAIL=contato@seu-dominio.com.br
BREVO_SENDER_NAME=Viuê

TMDB_READ_ACCESS_TOKEN=substitua_pelo_token_de_leitura_do_tmdb
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
